npm run dev      # Desarrollo con nodemon
npm run init-db  # Inicializar/resetear base de datos
```

### Frontend Commands
```bash
npm run dev      # Desarrollo con HMR
npm run build    # Build para producción
npm run preview  # Preview del build
```

