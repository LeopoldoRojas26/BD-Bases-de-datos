## ⚡ EJEMPLO: Crear Triggers para Sprint 4

Si necesitas los triggers del proyecto, aquí están listos para copiar:

### Trigger 1: Validar Stock (RAISE EXCEPTION)

```sql
-- Trigger 1: Validar stock ANTES de venta
DROP TRIGGER IF EXISTS trigger_validar_stock ON ventas;
DROP FUNCTION IF EXISTS validar_stock_disponible();

CREATE OR REPLACE FUNCTION validar_stock_disponible()
RETURNS TRIGGER AS $$
DECLARE
  stock_actual INTEGER;
  nombre_producto VARCHAR(100);
BEGIN
  -- Obtener el stock actual del producto
  SELECT stock, nombre INTO stock_actual, nombre_producto
  FROM productos
  WHERE id = NEW.producto_id;

  -- Validar que haya stock suficiente
  IF stock_actual < NEW.cantidad THEN
    RAISE EXCEPTION 'Stock insuficiente para el producto "%" (ID: %). Stock disponible: %, Cantidad solicitada: %',
      nombre_producto, NEW.producto_id, stock_actual, NEW.cantidad;
  END IF;

  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trigger_validar_stock
BEFORE INSERT ON ventas
FOR EACH ROW
EXECUTE FUNCTION validar_stock_disponible();
```

### Trigger 2: Descontar Stock Automáticamente

```sql
-- Trigger 2: Descontar stock DESPUÉS de venta
DROP TRIGGER IF EXISTS trigger_descontar_stock ON ventas;
DROP FUNCTION IF EXISTS descontar_stock_y_auditar();

CREATE OR REPLACE FUNCTION descontar_stock_y_auditar()
RETURNS TRIGGER AS $$
DECLARE
  stock_anterior INTEGER;
  stock_nuevo INTEGER;
BEGIN
  -- Obtener el stock actual
  SELECT stock INTO stock_anterior
  FROM productos
  WHERE id = NEW.producto_id;

  -- Descontar el stock
  UPDATE productos
  SET stock = stock - NEW.cantidad,
      updated_at = CURRENT_TIMESTAMP
  WHERE id = NEW.producto_id;

  -- Obtener el nuevo stock
  SELECT stock INTO stock_nuevo
  FROM productos
  WHERE id = NEW.producto_id;

  -- Registrar en auditoría (si existe la tabla)
  BEGIN
    INSERT INTO auditoria_stock (producto_id, stock_anterior, stock_nuevo, motivo)
    VALUES (NEW.producto_id, stock_anterior, stock_nuevo, 'VENTA');
  EXCEPTION WHEN undefined_table THEN
    -- Si no existe la tabla, ignorar
    NULL;
  END;

  -- Validar que el stock no sea negativo
  IF stock_nuevo < 0 THEN
    RAISE EXCEPTION 'Error crítico: El stock resultante es negativo (%). Transacción cancelada.', stock_nuevo;
  END IF;

  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trigger_descontar_stock
AFTER INSERT ON ventas
FOR EACH ROW
EXECUTE FUNCTION descontar_stock_y_auditar();
```

