# ============================================
# CONFIGURACIÓN DE BASE DE DATOS
# ============================================

# Opción 1: DBngin / PostgreSQL LOCAL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=redmarket_db

# Opción 2: Supabase (comentar Opción 1 y descomentar esta)
# DB_HOST=db.xxxxxxxxxxxxxxxx.supabase.co
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=tu_password_supabase
# DB_NAME=postgres

# 📝 INSTRUCCIONES:
# 
# Para DBngin:
#   - DB_HOST = localhost
#   - DB_PORT = verificar en DBngin (usualmente 5432 o 5433)
#   - DB_USER = postgres o tu usuario del sistema
#   - DB_PASSWORD = dejar vacío si no configuraste contraseña
#   - DB_NAME = nombre de tu base de datos local
#
# Para Supabase:
#   - DB_HOST = obtenerlo de: Settings → Database → Connection String (buscar "Host")
#   - DB_PORT = 5432
#   - DB_USER = postgres
#   - DB_PASSWORD = la contraseña que configuraste en Supabase
#   - DB_NAME = postgres
#
# IMPORTANTE: Los triggers y la estructura de la base de datos 
# deben ejecutarse directamente en:
#   - DBngin: usando pgAdmin, DBeaver o psql
#   - Supabase: usando el SQL Editor de Supabase

# ============================================
# SERVIDOR
# ============================================
PORT=3000
