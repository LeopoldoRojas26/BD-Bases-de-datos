-- Reportes precompilados directamente en la base de datos
-- =====================================================

-- Vista 1: Resumen de órdenes de compra por proveedor
CREATE OR REPLACE VIEW vw_ordenes_por_proveedor AS
SELECT 
    p.id_proveedor,
    p.nombre_proveedor,
    p.correo,
    COUNT(DISTINCT oc.id_orden_compra) AS total_ordenes,
    SUM(oc.total_orden) AS monto_total_comprado,
    AVG(oc.total_orden) AS promedio_por_orden,
    MIN(oc.fecha_orden) AS primera_orden,
    MAX(oc.fecha_orden) AS ultima_orden,
    COUNT(CASE WHEN oc.estado_orden = 'recibida' THEN 1 END) AS ordenes_recibidas,
    COUNT(CASE WHEN oc.estado_orden = 'pendiente' THEN 1 END) AS ordenes_pendientes,
    COUNT(CASE WHEN oc.estado_orden = 'enviada' THEN 1 END) AS ordenes_enviadas
FROM proveedor p
LEFT JOIN orden_compra oc ON p.id_proveedor = oc.id_proveedor
WHERE p.estado = 'activo'
GROUP BY p.id_proveedor, p.nombre_proveedor, p.correo
ORDER BY monto_total_comprado DESC NULLS LAST;

COMMENT ON VIEW vw_ordenes_por_proveedor IS 'Resumen estadístico de órdenes de compra agrupadas por proveedor';

-- Vista 2: Productos más solicitados
CREATE OR REPLACE VIEW vw_productos_mas_solicitados AS
SELECT 
    pr.id_producto,
    pr.nombre AS nombre_producto,
    cp.nombre AS categoria,
    pr.precio AS precio_actual,
    COUNT(DISTINCT doc.id_orden_compra) AS veces_ordenado,
    SUM(doc.cantidad) AS cantidad_total_ordenada,
    SUM(doc.subtotal) AS monto_total_ventas,
    AVG(doc.precio_unitario) AS precio_promedio_compra,
    ROUND(SUM(doc.cantidad) * 100.0 / NULLIF(SUM(SUM(doc.cantidad)) OVER(), 0), 2) AS porcentaje_ventas
FROM producto pr
INNER JOIN categoria_producto cp ON pr.id_categoria = cp.id_categoria
INNER JOIN detalle_orden_compra doc ON pr.id_producto = doc.id_producto
GROUP BY pr.id_producto, pr.nombre, cp.nombre, pr.precio
ORDER BY cantidad_total_ordenada DESC;

COMMENT ON VIEW vw_productos_mas_solicitados IS 'Ranking de productos más solicitados con estadísticas de compra';

-- Vista 3: Detalle completo de órdenes de compra
CREATE OR REPLACE VIEW vw_detalle_ordenes_compra AS
SELECT 
    oc.id_orden_compra,
    oc.fecha_orden,
    p.nombre_proveedor,
    p.telefono AS telefono_proveedor,
    p.correo AS correo_proveedor,
    oc.estado_orden,
    oc.fecha_entrega,
    prod.nombre AS nombre_producto,
    cp.nombre AS categoria,
    doc.cantidad,
    doc.precio_unitario,
    doc.subtotal,
    oc.total_orden,
    CASE 
        WHEN oc.fecha_entrega IS NOT NULL 
        THEN oc.fecha_entrega - oc.fecha_orden 
        ELSE NULL 
    END AS dias_entrega,
    rm.fecha_recepcion,
    rm.recibido_por,
    rm.estado_recepcion,
    rm.observaciones AS observaciones_recepcion
FROM orden_compra oc
INNER JOIN proveedor p ON oc.id_proveedor = p.id_proveedor
INNER JOIN detalle_orden_compra doc ON oc.id_orden_compra = doc.id_orden_compra
INNER JOIN producto prod ON doc.id_producto = prod.id_producto
INNER JOIN categoria_producto cp ON prod.id_categoria = cp.id_categoria
LEFT JOIN recepcion_mercancia rm ON oc.id_orden_compra = rm.id_orden_compra
ORDER BY oc.fecha_orden DESC, oc.id_orden_compra, prod.nombre;

COMMENT ON VIEW vw_detalle_ordenes_compra IS 'Vista detallada de todas las órdenes con información de productos, proveedores y recepción';

-- Vista 4: Análisis de recepciones de mercancía
CREATE OR REPLACE VIEW vw_analisis_recepciones AS
SELECT 
    rm.id_recepcion,
    rm.fecha_recepcion,
    oc.id_orden_compra,
    oc.fecha_orden,
    p.nombre_proveedor,
    rm.recibido_por,
    rm.estado_recepcion,
    oc.total_orden,
    EXTRACT(DAY FROM rm.fecha_recepcion - oc.fecha_orden) AS dias_desde_orden,
    CASE 
        WHEN rm.estado_recepcion = 'completa' THEN 'A tiempo'
        WHEN rm.estado_recepcion = 'parcial' THEN 'Incompleta'
        WHEN rm.estado_recepcion = 'pendiente' THEN 'Pendiente'
        ELSE 'Rechazada'
    END AS estado_descripcion,
    rm.observaciones,
    COUNT(doc.id_detalle_orden) AS items_en_orden
FROM recepcion_mercancia rm
INNER JOIN orden_compra oc ON rm.id_orden_compra = oc.id_orden_compra
INNER JOIN proveedor p ON oc.id_proveedor = p.id_proveedor
LEFT JOIN detalle_orden_compra doc ON oc.id_orden_compra = doc.id_orden_compra
GROUP BY rm.id_recepcion, rm.fecha_recepcion, oc.id_orden_compra, oc.fecha_orden, 
         p.nombre_proveedor, rm.recibido_por, rm.estado_recepcion, oc.total_orden, rm.observaciones
ORDER BY rm.fecha_recepcion DESC;

COMMENT ON VIEW vw_analisis_recepciones IS 'Análisis de recepciones con tiempos de entrega y estados';

-- Vista 5: Resumen financiero por categoría de producto
CREATE OR REPLACE VIEW vw_resumen_por_categoria AS
SELECT 
    cp.nombre AS categoria,
    COUNT(DISTINCT pr.id_producto) AS productos_diferentes,
    COUNT(DISTINCT doc.id_orden_compra) AS ordenes_relacionadas,
    SUM(doc.cantidad) AS unidades_totales,
    SUM(doc.subtotal) AS monto_total,
    AVG(doc.precio_unitario) AS precio_promedio,
    MIN(doc.precio_unitario) AS precio_minimo,
    MAX(doc.precio_unitario) AS precio_maximo,
    ROUND(SUM(doc.subtotal) * 100.0 / NULLIF(SUM(SUM(doc.subtotal)) OVER(), 0), 2) AS porcentaje_inversion
FROM producto pr
INNER JOIN categoria_producto cp ON pr.id_categoria = cp.id_categoria
INNER JOIN detalle_orden_compra doc ON pr.id_producto = doc.id_producto
GROUP BY cp.nombre
ORDER BY monto_total DESC;

COMMENT ON VIEW vw_resumen_por_categoria IS 'Resumen financiero y estadístico agrupado por categoría de producto';

-- Vista 6: Órdenes pendientes de entrega
CREATE OR REPLACE VIEW vw_ordenes_pendientes AS
SELECT 
    oc.id_orden_compra,
    oc.fecha_orden,
    p.nombre_proveedor,
    p.telefono,
    p.correo,
    oc.total_orden,
    oc.estado_orden,
    oc.fecha_entrega,
    CASE 
        WHEN oc.fecha_entrega IS NULL THEN NULL
        WHEN oc.fecha_entrega < CURRENT_DATE THEN CURRENT_DATE - oc.fecha_entrega
        ELSE 0
    END AS dias_retraso,
    COUNT(doc.id_detalle_orden) AS items_totales,
    STRING_AGG(DISTINCT cp.nombre, ', ') AS categorias_productos
FROM orden_compra oc
INNER JOIN proveedor p ON oc.id_proveedor = p.id_proveedor
INNER JOIN detalle_orden_compra doc ON oc.id_orden_compra = doc.id_orden_compra
INNER JOIN producto prod ON doc.id_producto = prod.id_producto
INNER JOIN categoria_producto cp ON prod.id_categoria = cp.id_categoria
WHERE oc.estado_orden IN ('pendiente', 'enviada')
GROUP BY oc.id_orden_compra, oc.fecha_orden, p.nombre_proveedor, p.telefono, 
         p.correo, oc.total_orden, oc.estado_orden, oc.fecha_entrega
ORDER BY oc.fecha_orden ASC;

COMMENT ON VIEW vw_ordenes_pendientes IS 'Listado de órdenes pendientes y enviadas con información de retrasos';

-- Vista 7: Rendimiento de empleados en recepción
CREATE OR REPLACE VIEW vw_rendimiento_recepcion AS
SELECT 
    rm.recibido_por,
    COUNT(DISTINCT rm.id_recepcion) AS total_recepciones,
    COUNT(CASE WHEN rm.estado_recepcion = 'completa' THEN 1 END) AS recepciones_completas,
    COUNT(CASE WHEN rm.estado_recepcion = 'parcial' THEN 1 END) AS recepciones_parciales,
    COUNT(CASE WHEN rm.estado_recepcion = 'rechazada' THEN 1 END) AS recepciones_rechazadas,
    ROUND(COUNT(CASE WHEN rm.estado_recepcion = 'completa' THEN 1 END) * 100.0 / 
          NULLIF(COUNT(*), 0), 2) AS porcentaje_efectividad,
    SUM(oc.total_orden) AS valor_total_recibido,
    MIN(rm.fecha_recepcion) AS primera_recepcion,
    MAX(rm.fecha_recepcion) AS ultima_recepcion
FROM recepcion_mercancia rm
INNER JOIN orden_compra oc ON rm.id_orden_compra = oc.id_orden_compra
GROUP BY rm.recibido_por
ORDER BY total_recepciones DESC, porcentaje_efectividad DESC;

COMMENT ON VIEW vw_rendimiento_recepcion IS 'Análisis de rendimiento de empleados en proceso de recepción de mercancía';

-- Vista 8: Historial de compras mensual
CREATE OR REPLACE VIEW vw_compras_mensuales AS
SELECT 
    TO_CHAR(oc.fecha_orden, 'YYYY-MM') AS mes,
    EXTRACT(YEAR FROM oc.fecha_orden) AS anio,
    EXTRACT(MONTH FROM oc.fecha_orden) AS numero_mes,
    COUNT(DISTINCT oc.id_orden_compra) AS total_ordenes,
    COUNT(DISTINCT oc.id_proveedor) AS proveedores_diferentes,
    SUM(oc.total_orden) AS monto_total,
    AVG(oc.total_orden) AS promedio_orden,
    MIN(oc.total_orden) AS orden_minima,
    MAX(oc.total_orden) AS orden_maxima,
    SUM(CASE WHEN oc.estado_orden = 'recibida' THEN oc.total_orden ELSE 0 END) AS monto_recibido,
    SUM(CASE WHEN oc.estado_orden = 'pendiente' THEN oc.total_orden ELSE 0 END) AS monto_pendiente
FROM orden_compra oc
GROUP BY TO_CHAR(oc.fecha_orden, 'YYYY-MM'), 
         EXTRACT(YEAR FROM oc.fecha_orden), 
         EXTRACT(MONTH FROM oc.fecha_orden)
ORDER BY anio DESC, numero_mes DESC;

COMMENT ON VIEW vw_compras_mensuales IS 'Resumen de compras agrupado por mes con métricas financieras';


